<?xml version="1.0" encoding="utf-8"?>
<!-- The bubble edition (Murmur Bubble): a floating hold-to-talk button above any keyboard. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application>
        <!-- Shows the floating Murmur button above your keyboard and types the text into the
             focused field. Records only while you hold the button (as a microphone foreground service). -->
        <service
            android:name=".MurmurService"
            android:exported="true"
            android:foregroundServiceType="microphone"
            android:label="Murmur Bubble"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_config" />
        </service>
    </application>
</manifest>
